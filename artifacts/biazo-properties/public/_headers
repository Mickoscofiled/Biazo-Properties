# Cloudflare Pages Caching and Performance Headers

# Immutable cache for build assets (JS, CSS, images, fonts with content hashes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Cache logos and favicons with stale-while-revalidate
/biazo-logo*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML pages - revalidate ETag so updates appear immediately without browser caching old code
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Global security headers for speed & protection
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
